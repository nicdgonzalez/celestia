---
const currentPath = Astro.url.pathname;

const navLinks = [
  {
    href: "/",
    text: "Home",
  },
  {
    href: "/servers",
    text: "Servers",
  },
];

function isActive(path: string): boolean {
  return path === currentPath;
}
---

<header class="fixed top-0 w-full p-8">
  <nav class="flex flex-row justify-between font-medium text-white">
    <a href="/">Celestia Dashboard</a>
    <ul class="flex flex-row gap-x-4">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                isActive(link.href) ? "after:bg-green-500" : "",
                "hover:text-green-500",
                "flex",
                "flex-col",
                "after:content-['']",
                "after:h-0.5",
                "after:w-full",
              ]}
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
